    {
      "src_cell": 0, "dst_cell": 1,
      "wire_type": { "Modulation": { "target_param": "freq" } },
      "gain": 1.0, "mode": "Replace"
    },
    {
      "src_cell": 2, "dst_cell": 1,
      "wire_type": { "Modulation": { "target_param": "gain" } },
