    { "src_cell": 1, "dst_cell": 3, "wire_type": "Audio", "gain": 1.0, "mode": "Add" },
    { "src_cell": 3, "dst_cell": 4, "wire_type": "Audio", "gain": 1.0, "mode": "Add" }
