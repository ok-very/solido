{
  "_comment": "SAWL species: call-response organism. Human plays MIDI phrase, organism listens then responds with mutated interpretation. Gap-mode phrase detection, raga-friendly gravity quantization.",
  "name": "sawl-raga",
  "species": "sawl",
  "seed": 7777,
  "version": 1,

  "cells": [
    {
